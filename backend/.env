PORT=5000

# SMTP settings: for Gmail use app password OR configure OAuth2 (preferred for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false # true for 465, false for 587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_smtp_app_password_or_password

# From and admin (where copies/alerts go)
FROM_EMAIL=bytbrand.info@gmail.com
ADMIN_EMAIL=owner@yourdomain.com

# Frontend origin for CORS (adjust)
FRONTEND_ORIGIN=http://localhost:5173