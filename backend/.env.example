# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://bytbrand.vercel.app,https://website-sicknick-backend.onrender.com

# Email Configuration (for Nodemailer with retry logic)
# This will override the legacy EMAIL_ settings if provided
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bytbrand.info@gmail.com
SMTP_PASS=your_app_password_here
ADMIN_EMAILS=bytbrand.info@gmail.com

# Firebase Authentication (Service Account JSON)
# For Render deployment, insert the JSON directly here, or mount as a secret file
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
