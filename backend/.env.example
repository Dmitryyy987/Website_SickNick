PORT=5000
NODE_ENV=development

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.vercel.app

# SMTP / Email settings
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password
ADMIN_EMAILS=your-email@example.com

# Optional SMTP override
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Firebase service account (recommended for production)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# OR use a path to a local file (not committed)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebaseServiceAccount.json
